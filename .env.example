# Copy to .env (gitignored). All optional.

# Where personal data lives. Default: ~\.internship-autopilot\data
# Keep this OUT of OneDrive/Dropbox and AppData: it holds your profile, database and browser logins.
IAP_DATA_DIR=

# Optional: a GitHub personal access token (no scopes needed) for outreach lookups,
# raising GitHub's anonymous limit of 60 requests/hour.
GITHUB_TOKEN=
